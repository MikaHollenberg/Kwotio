# Kopieer dit bestand naar .env.local en vul de waarden aan.
# Te vinden in het Supabase-dashboard: Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Alleen server-side gebruiken (nooit met NEXT_PUBLIC_ prefix!) — omzeilt RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Fase 4+ (transactionele e-mail, zie resend.com)
RESEND_API_KEY=

# Fase 6 — beveiligt /api/cron/notifications (herinneringsmails, verlopen
# offertes). Zelf een lang willekeurig wachtwoord verzinnen; op Vercel wordt
# dit automatisch als Bearer-token meegestuurd door Vercel Cron.
CRON_SECRET=
